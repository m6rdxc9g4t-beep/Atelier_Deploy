# ── Adresse ─────────────────────────────────────────────────────────────────
# Domaine du portail. Les apps vivent sur ses sous-domaines :
#   nexus.<domaine>  viz.<domaine>  tab.<domaine>  projets.<domaine>  wiki.<domaine>…
# DNS (chez OVH) : deux enregistrements A vers l'IP du VPS
#   atelier.mondomaine.fr     A  <IP>
#   *.atelier.mondomaine.fr   A  <IP>
ATELIER_DOMAIN=atelier.mondomaine.fr

# E-mail pour Let's Encrypt (alertes d'expiration des certificats)
ACME_EMAIL=

# ── Connexion au portail ────────────────────────────────────────────────────
PORTAL_USER=francois
# install.sh génère un mot de passe et un secret si ces champs sont vides
PORTAL_PASSWORD=
SESSION_SECRET=
# Durée de la session en jours
SESSION_DAYS=30

# ── Base de Nexus (PostgreSQL) ──────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── IA ──────────────────────────────────────────────────────────────────────
# Clé API Anthropic pour les agents de Nexus et l'assistant de Viz (facultatif)
ANTHROPIC_API_KEY=
# anthropic ou ollama (ollama : lancer avec --profile ollama)
NEXUS_LLM_PROVIDER=anthropic

# ── Liens entre apps ────────────────────────────────────────────────────────
# Jeton pour l'import Atelier Tab → Atelier Projets (généré par install.sh)
ATELIER_IMPORT_TOKEN=
# Clé secrète Flask de Savoir et Trésorerie (générée par install.sh / update.sh)
APPS_SECRET_KEY=
# Jeton GitHub utilisé PAR les apps (synchro des rapports Viz, Git de Projets, agent Développeur de Nexus)
APPS_GITHUB_TOKEN=

# ── Récupération du code ────────────────────────────────────────────────────
# Jeton GitHub à grain fin, lecture seule (« Contents: Read ») sur Atelier_Deploy et les dépôts des apps hébergées :
# Atelier_Nexus, Atelier_Viz, atelier-tab, Atelier_Projets, Atelier_Wiki, Atelier_Cine, Atelier-Savoir, Atelier_Tr-sorerie
GITHUB_CLONE_TOKEN=
GITHUB_OWNER=m6rdxc9g4t-beep
# Branche déployée pour chaque app
BRANCH_NEXUS=main
BRANCH_VIZ=main
BRANCH_TAB=main
BRANCH_PROJETS=main
BRANCH_WIKI=main
BRANCH_CINE=main
BRANCH_SAVOIR=main
BRANCH_TRESORERIE=main

# ── Apps en ligne (liens du portail, elles gardent leur propre connexion) ───
# Adresse de ta version en ligne d'Atelier Suivi (vide = tuile « à renseigner »)
SUIVI_URL=
CUISINE_URL=https://atelier-cuisine-iota.vercel.app
DATES_URL=https://atelier-dates.vercel.app/accueil

TZ=Europe/Paris

# ── Essais en local uniquement (ne pas toucher sur le VPS) ──────────────────
# PROTO=http
# SITE_SCHEME=http://
