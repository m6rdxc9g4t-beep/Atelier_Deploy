# ── Adresse ─────────────────────────────────────────────────────────────────
# Domaine du portail. Les apps vivent sur ses sous-domaines :
#   nexus.<domaine>  viz.<domaine>  tab.<domaine>  projets.<domaine>  wiki.<domaine>  formulaire.<domaine>…
# DNS (chez OVH) : deux enregistrements A vers l'IP du VPS
#   atelier.mondomaine.fr     A  <IP>
#   *.atelier.mondomaine.fr   A  <IP>
ATELIER_DOMAIN=atelier.mondomaine.fr

# E-mail pour Let's Encrypt (alertes d'expiration des certificats)
ACME_EMAIL=

# ── Connexion au portail ────────────────────────────────────────────────────
PORTAL_USER=francois
# install.sh génère un mot de passe et un secret si ces champs sont vides
PORTAL_PASSWORD=
SESSION_SECRET=
# Durée de la session en jours
SESSION_DAYS=30

# ── Base de Nexus (PostgreSQL) ──────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── IA ──────────────────────────────────────────────────────────────────────
# IA du serveur (Ollama), partagée par toutes les apps hébergées, Tab compris.
# Modèle unique, choisi par install.sh / update.sh selon la mémoire si vide :
#   ≥ 10 Go → llama3.1:8b   ·   ≥ 5 Go → llama3.2:3b   ·   moins → llama3.2:1b
# Pour en changer : modifier la ligne puis « sudo ./update.sh » (téléchargement du nouveau modèle).
OLLAMA_MODEL=
# Clé API Anthropic, facultative : Claude en plus de l'IA du serveur (Nexus, Viz, Convert, DataMind)
ANTHROPIC_API_KEY=
# Moteur par défaut de Nexus : ollama (IA du serveur) ou anthropic (avec la clé ci-dessus)
NEXUS_LLM_PROVIDER=ollama

# ── Liens entre apps ────────────────────────────────────────────────────────
# Jeton pour l'import Atelier Tab → Atelier Projets (généré par install.sh)
ATELIER_IMPORT_TOKEN=
# Clé secrète Flask de Savoir et Trésorerie (générée par install.sh / update.sh)
APPS_SECRET_KEY=
# Jeton GitHub utilisé PAR les apps (synchro des rapports Viz, Git de Projets, agent Développeur de Nexus)
APPS_GITHUB_TOKEN=

# ── Récupération du code ────────────────────────────────────────────────────
# Jeton GitHub à grain fin, lecture seule (« Contents: Read ») sur Atelier_Deploy et les dépôts des apps hébergées :
# Atelier_Nexus, Atelier_Viz, atelier-tab, Atelier_Projets, Atelier_Wiki, Atelier_Formulaire, Atelier_Cine, Atelier-Savoir, Atelier_Tr-sorerie
GITHUB_CLONE_TOKEN=
GITHUB_OWNER=m6rdxc9g4t-beep
# Branche déployée pour chaque app
BRANCH_NEXUS=main
BRANCH_VIZ=main
BRANCH_TAB=main
BRANCH_PROJETS=main
BRANCH_WIKI=main
BRANCH_FORMULAIRE=main
BRANCH_CINE=main
BRANCH_SAVOIR=main
BRANCH_TRESORERIE=main
# DataMind (https://datamind.<domaine>) : dépôt public Agent_Data
BRANCH_DATAMIND=main
# Claude avec ton forfait (Pro / Max), sans clé API : sur ton Mac, lance « claude setup-token »
# et colle ici le jeton obtenu (sk-ant-oat01-…). Usage personnel : DataMind est derrière ta connexion au portail.
DATAMIND_CLAUDE_OAUTH_TOKEN=
# Moteur proposé à l'ouverture : vide = Claude si le jeton ci-dessus est renseigné, sinon l'IA du serveur (ollama)
DATAMIND_ENGINE=
# Démo publique (https://demo-datamind.<domaine>, Vitrine pro) : même app en mode démo, jeux d'exemple seulement,
# IA du serveur uniquement (jamais le jeton ni la clé ci-dessus). Questions à l'IA par heure et par visiteur :
DATAMIND_DEMO_QUESTIONS_PAR_HEURE=10

# ── Apps en ligne, sur Vercel uniquement (liens du portail ; dates.… et suivi.… y redirigent) ──
CUISINE_URL=https://atelier-cuisine-iota.vercel.app
SUIVI_URL=https://atelier-suivi-bay.vercel.app
DATES_URL=https://atelier-dates.vercel.app

# ── Mise à jour automatique (sudo ./auto-update.sh install) ─────────────────
# Apps dont le VPS suit GitHub toutes les 5 minutes, comme Vercel (noms de update.sh, séparés par des espaces).
# Exemple : AUTO_UPDATE_APPS=ops portfolio
AUTO_UPDATE_APPS=

# ── Portfolio (https://portfolio.<domaine>) ─────────────────────────────────
# Site public, sans la connexion du portail. Dépôt public Atelier_Portefolio.
BRANCH_PORTFOLIO=main
# Relais Netlify du Portfolio (netlify/portfolio) : même valeur que la variable PORTFOLIO_PROXY_SECRET du site Netlify.
# Générée automatiquement par install.sh / update.sh si vide.
PORTFOLIO_PROXY_SECRET=
# Adresse publique du Portfolio et de ses démos (section « Vitrine pro » du portail : liens à copier pour les recruteurs).
# Ex. https://francois-pichon.netlify.app une fois le relais Netlify en place ; vide = https://portfolio.<domaine>.
PORTFOLIO_PUBLIC_URL=
# Observatoire immobilier : départements DVF téléchargés à la construction du Portfolio.
DVF_DEPARTEMENTS=49,62,59,44,35

# ── Sites & tests (section du portail) ──────────────────────────────────────
# Agent Ops Lab (https://ops.<domaine>) : dépôt public agent-ops-lab.
BRANCH_OPS=main

# Atelier Mission (https://mission.<domaine>) : mini-CRM freelance, dépôt public Atelier_Mission.
BRANCH_MISSION=main
# Relances par e-mail (Brevo › SMTP & API › Clés API, xkeysib-…), facultatif.
MISSION_BREVO_API_KEY=
# Plateforme agréée SUPER PDP (facturation électronique), facultatif : identifiants OAuth de l'app.
MISSION_SUPERPDP_CLIENT_ID=
MISSION_SUPERPDP_CLIENT_SECRET=
# Vide = https://api.superpdp.tech
MISSION_SUPERPDP_URL=

TZ=Europe/Paris

# ── Essais en local uniquement (ne pas toucher sur le VPS) ──────────────────
# PROTO=http
# SITE_SCHEME=http://
