# Suite Atelier : portail + apps, HTTPS automatique (Let's Encrypt).
#
#   {$ATELIER_DOMAIN}           portail (choix de l'app) + connexion
#   nexus.{$ATELIER_DOMAIN}     Atelier Nexus  (interface :3100, API :8100)
#   viz.{$ATELIER_DOMAIN}       Atelier Viz    (:8000, sert aussi son interface)
#   tab.{$ATELIER_DOMAIN}       Atelier Tab    (fichiers statiques ; /ollama/ = IA du serveur pour l'assistant)
#   convert.{$ATELIER_DOMAIN}   Atelier Convert (:8010, sert aussi son interface ; OCR Tesseract)
#   projets.{$ATELIER_DOMAIN}   Atelier Projets (interface statique + API :3000)
#   wiki.{$ATELIER_DOMAIN}      Atelier Wiki   (:3200, sert aussi son interface)
#   formulaire.{$ATELIER_DOMAIN} Atelier Formulaire (:3300 ; réponse par lien public sans connexion)
#   tresorerie.{$ATELIER_DOMAIN} Atelier Trésorerie (:5050)
#   savoir.{$ATELIER_DOMAIN}    Atelier Savoir (:5051)
#   cine.{$ATELIER_DOMAIN}      Atelier Ciné   (:4000, vidéos en flux)
#   dates.{$ATELIER_DOMAIN}     redirection vers Atelier Dates sur Vercel
#   suivi.{$ATELIER_DOMAIN}     redirection vers Atelier Suivi sur Vercel
#   portfolio.{$ATELIER_DOMAIN} Atelier Portfolio (:8787 ; site public, sans la connexion du portail)
#   Cuisine, Dates et Suivi sont des apps en ligne (Vercel) : simples liens du portail.
#
# Toutes les apps écoutent sur 127.0.0.1 uniquement : seul Caddy est exposé.
# Chaque requête passe d'abord par le portail (forward_auth) qui vérifie le cookie de session,
# SITE_SCHEME=http:// sert uniquement aux essais en local, sans certificat.
{
	email {$ACME_EMAIL}
}

(securite) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format console
		level WARN
	}
}

(connexion) {
	forward_auth 127.0.0.1:9000 {
		uri /auth/verify
		copy_headers X-Atelier-User
	}
}

# Les sondes /api/health restent publiques (elles ne disent que « ok ») :
# le sélecteur de suite intégré à chaque app s'en sert d'un domaine à l'autre.
(sante_publique) {
	header Access-Control-Allow-Origin *
	header Cache-Control no-store
}

{$SITE_SCHEME}{$ATELIER_DOMAIN} {
	import securite
	reverse_proxy 127.0.0.1:9000
}

{$SITE_SCHEME}viz.{$ATELIER_DOMAIN} {
	import securite
	handle /api/health {
		import sante_publique
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		import connexion
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}
}

{$SITE_SCHEME}tab.{$ATELIER_DOMAIN} {
	import securite
	handle /api/health {
		import sante_publique
		header Content-Type application/json
		respond `{"status":"ok","app":"atelier-tab"}` 200
	}
	# Assistant de Tab : l'Ollama du serveur, sur la même origine, après connexion au portail.
	# Seules les routes dont l'assistant a besoin passent (pas de téléchargement ni de suppression de modèle).
	@ollama path /ollama/api/chat /ollama/api/tags /ollama/api/show /ollama/api/version
	handle @ollama {
		import connexion
		uri strip_prefix /ollama
		reverse_proxy 127.0.0.1:11434 {
			# Ollama n'accepte que ses propres noms d'hôte et origines : la requête arrive comme locale.
			header_up Host 127.0.0.1:11434
			header_up -Origin
			header_up -Referer
			flush_interval -1
		}
	}
	handle /ollama/* {
		respond "Route d'Ollama non autorisée" 403
	}
	handle {
		# route : la connexion est vérifiée avant la réécriture vers index.html
		route {
			import connexion
			root * /srv/tab
			@html path / /index.html
			header @html Cache-Control no-cache
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			try_files {path} /index.html
			file_server
		}
	}
}

{$SITE_SCHEME}convert.{$ATELIER_DOMAIN} {
	import securite
	# Fichiers à convertir : 50 Mo au plus (MAX_UPLOAD_MB), plus l'enveloppe multipart.
	request_body /api/* {
		max_size 55MB
	}
	handle /api/health {
		import sante_publique
		reverse_proxy 127.0.0.1:8010
	}
	handle {
		import connexion
		reverse_proxy 127.0.0.1:8010
	}
}

{$SITE_SCHEME}projets.{$ATELIER_DOMAIN} {
	import securite
	request_body /api/* {
		max_size 25MB
	}
	handle /api/health {
		import sante_publique
		reverse_proxy 127.0.0.1:3000
	}
	handle /api/* {
		import connexion
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}
	handle {
		# route : la connexion est vérifiée avant la réécriture vers index.html
		route {
			import connexion
			root * /srv/projets
			@html path / /index.html
			header @html Cache-Control no-cache
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			try_files {path} /index.html
			file_server
		}
	}
}

{$SITE_SCHEME}wiki.{$ATELIER_DOMAIN} {
	import securite
	# Pièces jointes du Wiki : 20 Mo par fichier (WIKI_MAX_UPLOAD_MB), plus l'enveloppe multipart.
	request_body /api/* {
		max_size 25MB
	}
	handle /api/health {
		import sante_publique
		reverse_proxy 127.0.0.1:3200
	}
	handle {
		import connexion
		reverse_proxy 127.0.0.1:3200
	}
}

{$SITE_SCHEME}formulaire.{$ATELIER_DOMAIN} {
	import securite
	request_body /api/* {
		max_size 1MB
	}
	handle /api/health {
		import sante_publique
		reverse_proxy 127.0.0.1:3300
	}
	# Réponse par lien public : la page /r/<lien secret>, son API et les fichiers de l'interface sont
	# ouverts sans connexion. Le reste (formulaires, réponses, exports) passe par le portail.
	@public path /r/* /api/public/* /assets/* /favicon.svg /theme-init.js
	handle @public {
		reverse_proxy 127.0.0.1:3300
	}
	handle {
		import connexion
		reverse_proxy 127.0.0.1:3300
	}
}

{$SITE_SCHEME}nexus.{$ATELIER_DOMAIN} {
	import securite
	request_body /api/* {
		max_size 50MB
	}
	@sante path /health /api/health
	handle @sante {
		import sante_publique
		reverse_proxy 127.0.0.1:8100
	}
	@api path /api/* /docs /docs/* /openapi.json
	handle @api {
		import connexion
		# flush_interval -1 : les réponses en flux (SSE) des agents arrivent au fil de l'eau
		reverse_proxy 127.0.0.1:8100 {
			flush_interval -1
		}
	}
	handle {
		import connexion
		reverse_proxy 127.0.0.1:3100
	}
}

{$SITE_SCHEME}tresorerie.{$ATELIER_DOMAIN} {
	import securite
	request_body /api/* {
		max_size 12MB
	}
	handle {
		import connexion
		reverse_proxy 127.0.0.1:5050
	}
}

{$SITE_SCHEME}savoir.{$ATELIER_DOMAIN} {
	import securite
	request_body /api/* {
		max_size 26MB
	}
	handle {
		import connexion
		reverse_proxy 127.0.0.1:5051 {
			flush_interval -1
		}
	}
}

{$SITE_SCHEME}cine.{$ATELIER_DOMAIN} {
	import securite
	handle {
		import connexion
		# Vidéos en flux (requêtes Range) : rien n'est mis en tampon
		reverse_proxy 127.0.0.1:4000 {
			flush_interval -1
		}
	}
}

# Dates et Suivi ne tournent plus sur le VPS (Vercel uniquement) : les anciennes adresses,
# favoris et apps installées depuis dates.… ou suivi.… arrivent sur la version Vercel.
{$SITE_SCHEME}dates.{$ATELIER_DOMAIN} {
	redir {$DATES_URL}{uri} permanent
}

{$SITE_SCHEME}suivi.{$ATELIER_DOMAIN} {
	redir {$SUIVI_URL}{uri} permanent
}

# Portfolio : site public destiné aux recruteurs, sans la connexion du portail.
# Le serveur applique ses propres en-têtes (helmet) et limite le formulaire de contact.
{$SITE_SCHEME}portfolio.{$ATELIER_DOMAIN} {
	import securite
	request_body /api/* {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:8787
}
